# Zig's userspace libc/libc++ toolchain, NOT the Dot kernel compiler.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_C_COMPILER "$ENV{ZIG_EXE}")
set(CMAKE_C_COMPILER_ARG1 cc)
set(CMAKE_CXX_COMPILER "$ENV{ZIG_EXE}")
set(CMAKE_CXX_COMPILER_ARG1 c++)
set(CMAKE_C_FLAGS_INIT "-target aarch64-linux.6.1-musl -mcpu=cortex_a53")
set(CMAKE_CXX_FLAGS_INIT "-target aarch64-linux.6.1-musl -mcpu=cortex_a53")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-static")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
