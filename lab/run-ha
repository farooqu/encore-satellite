#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
state="${ENCORE_LAB_STATE:-$HOME/.local/state/encore-lab}"
mkdir -p "$state/ha/custom_components"
chmod 700 "$state" "$state/ha"
cp "$root/lab/configuration.yaml" "$state/ha/configuration.yaml"
ln -sfn "$root/lab/custom_components/encore_fixture" "$state/ha/custom_components/encore_fixture"
exec "$root/lab/.venv/bin/hass" --skip-pip --config "$state/ha" --log-file "$state/ha/home-assistant.log"
