#!/usr/bin/env bash
set -euo pipefail
ROOT=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
STATE="$HOME/.local/state/encore-sendspin-lab"
SOURCE="$ROOT/.amp/in/orb-backup/upstream-research/music-assistant-server"
[[ $(git -C "$SOURCE" rev-parse HEAD) == 07780231361dd45668f937fc3fe950b38527fde0 ]] || exit 1
umask 077
export PATH="$ROOT/.amp/in/orb-backup/sendspin-server-tools/ffmpeg-n8.1.3-35-gf1acb0a266-linux64-gpl-8.1/bin:$PATH"
export PYTHONPATH="$SOURCE"
export URLLIB3_NO_OVERRIDE=1
export VIRTUAL_ENV="$STATE/venv"
exec "$STATE/venv/bin/python" "$ROOT/lab/sendspin/server/launcher.py"
