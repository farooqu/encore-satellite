#!/bin/sh
# Encore Dot 2 Linux owns the filter tables. Never run in a shared host namespace.
# Kernel 3.18 has legacy xt_state, NOT xt_conntrack or nftables.
set -eu
umask 077
[ "$#" -eq 1 ] && [ "$1" = apply ] || { echo 'usage: encore-firewall apply' >&2; exit 2; }
for tool in iptables-legacy-restore ip6tables-legacy-restore flock; do
  command -v "$tool" >/dev/null || { echo "encore-firewall: missing $tool" >&2; exit 1; }
done
mkdir -p /run/encore
exec 9>/run/encore/firewall.lock
flock -x 9

rules() {
  cat <<'EOF'
*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
-A INPUT -i lo -j ACCEPT
-A INPUT -m state --state ESTABLISHED,RELATED -j ACCEPT
-A INPUT -i wlan0 -p tcp --dport 6053 -j ACCEPT
-A INPUT -i wlan0 -p tcp --dport 6055 -j ACCEPT
EOF
  # Native Incubator is unauthenticated: 6055 is for a trusted Wi-Fi LAN only.
  # Sendspin is an outbound WebSocket client; it has no inbound listener.
  if [ "$1" = 4 ]; then
    cat <<'EOF'
-A INPUT -i wlan0 -p udp -d 224.0.0.251/32 --dport 5353 -j ACCEPT
-A INPUT -i wlan0 -p udp -d 224.0.0.0/4 --dport 5353 -j DROP
-A INPUT -i wlan0 -p udp -d 255.255.255.255/32 --dport 5353 -j DROP
-A INPUT -i wlan0 -p udp --sport 5353 --dport 5353 -j ACCEPT
-A INPUT -i wlan0 -p udp --sport 67 --dport 68 -j ACCEPT
-A INPUT -i wlan0 -p icmp --icmp-type 0 -j ACCEPT
-A INPUT -i wlan0 -p icmp --icmp-type 3 -j ACCEPT
-A INPUT -i wlan0 -p icmp --icmp-type 8 -j ACCEPT
-A INPUT -i wlan0 -p icmp --icmp-type 11 -j ACCEPT
-A INPUT -i wlan0 -p icmp --icmp-type 12 -j ACCEPT
EOF
  else
    cat <<'EOF'
-A INPUT -i wlan0 -p udp -d ff02::fb/128 --dport 5353 -j ACCEPT
-A INPUT -i wlan0 -p udp -d ff00::/8 --dport 5353 -j DROP
-A INPUT -i wlan0 -p udp --sport 5353 --dport 5353 -j ACCEPT
-A INPUT -i wlan0 -p udp -s fe80::/10 --sport 547 --dport 546 -j ACCEPT
-A INPUT -i wlan0 -p ipv6-icmp --icmpv6-type 1 -j ACCEPT
-A INPUT -i wlan0 -p ipv6-icmp --icmpv6-type 2 -j ACCEPT
-A INPUT -i wlan0 -p ipv6-icmp --icmpv6-type 3 -j ACCEPT
-A INPUT -i wlan0 -p ipv6-icmp --icmpv6-type 4 -j ACCEPT
-A INPUT -i wlan0 -p ipv6-icmp --icmpv6-type 128 -j ACCEPT
-A INPUT -i wlan0 -p ipv6-icmp --icmpv6-type 129 -j ACCEPT
-A INPUT -i wlan0 -p ipv6-icmp -s fe80::/10 --icmpv6-type 130 -j ACCEPT
-A INPUT -i wlan0 -p ipv6-icmp -s fe80::/10 --icmpv6-type 134 -j ACCEPT
-A INPUT -i wlan0 -p ipv6-icmp --icmpv6-type 135 -j ACCEPT
-A INPUT -i wlan0 -p ipv6-icmp --icmpv6-type 136 -j ACCEPT
EOF
  fi
  echo COMMIT
}

# Restore commits each family atomically, including DROP policies. Even if one
# fails, try the other before reporting failure to boot.
failed=0
rules 4 | iptables-legacy-restore -w 5 || failed=1
rules 6 | ip6tables-legacy-restore -w 5 || failed=1
if [ "$failed" -ne 0 ]; then
  echo 'encore-firewall: policy install failed; do not start networking' >&2
  exit 1
fi
