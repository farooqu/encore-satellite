# Non-release ARM32 compatibility experiment, not hardware qualification.
CONFIG_LOCALVERSION="-encore-biscuit-compat1"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_MMC_BLOCK_MINORS=32
CONFIG_KERNEL_GZIP=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_EVENTFD=y
CONFIG_TIMERFD=y
CONFIG_SIGNALFD=y
CONFIG_EPOLL=y
CONFIG_FUTEX=y
CONFIG_AIO=y
CONFIG_SYSVIPC=y
CONFIG_INOTIFY_USER=y
CONFIG_IPV6=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_BT=y
CONFIG_BT_LE=y
CONFIG_BT_HCIVHCI=y
# Keep existing stpbt/btbridge ownership; do not simultaneously open native HCI.
CONFIG_MTK_MT8163_BLUEZ_HCI=n
CONFIG_UHID=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
