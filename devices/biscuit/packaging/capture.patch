+/* Loss survives STOP/prepare/START until userspace observes it. Saturate so
+ * an arbitrarily delayed read can never mistake wrapped counters for zero. */
+static void amzn_spi_loss(struct amzn_spi_priv *priv, bool fpga)
+{
+	unsigned long flags;
+	size_t *counter = fpga ? &priv->fpga_overruns : &priv->kernel_overruns;
+
+	spin_lock_irqsave(&priv->state_lock, flags);
+	if (*counter < LONG_MAX)
+		(*counter)++;
+	spin_unlock_irqrestore(&priv->state_lock, flags);
+}
+
+static int amzn_spi_loss_info(struct snd_kcontrol *kcontrol,
+			      struct snd_ctl_elem_info *info)
+{
+	info->type = SNDRV_CTL_ELEM_TYPE_INTEGER;
+	info->count = 1;
+	info->value.integer.min = 0;
+	info->value.integer.max = LONG_MAX;
+	return 0;
+}
+
+static int amzn_spi_loss_get(struct snd_kcontrol *kcontrol,
+			     struct snd_ctl_elem_value *value)
+{
+	struct snd_soc_component *component = snd_soc_kcontrol_component(kcontrol);
+	struct amzn_spi_priv *priv = snd_soc_component_get_drvdata(component);
+	size_t *counter = kcontrol->private_value ?
+		&priv->fpga_overruns : &priv->kernel_overruns;
+	unsigned long flags;
+
+	spin_lock_irqsave(&priv->state_lock, flags);
+	value->value.integer.value[0] = *counter;
+	*counter = 0;
+	spin_unlock_irqrestore(&priv->state_lock, flags);
+	return 0;
+}
