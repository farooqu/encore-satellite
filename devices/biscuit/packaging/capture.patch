+static int amzn_mt_spi_pcm_sync_stop(struct snd_soc_component *component,
+				    struct snd_pcm_substream *substream)
+{
+	struct amzn_spi_priv *priv = snd_soc_component_get_drvdata(component);
+
+	amzn_spi_set_running(priv, false);
+	if (priv->spi_wq)
+		flush_workqueue(priv->spi_wq);
+	return 0;
+}
+
+static int amzn_mt_spi_pcm_prepare(struct snd_soc_component *component,
+				  struct snd_pcm_substream *substream)
+{
+	struct amzn_spi_priv *priv = snd_soc_component_get_drvdata(component);
+	unsigned long flags;
+
+	amzn_mt_spi_pcm_sync_stop(component, substream);
+	/* No worker can still publish pre-privacy samples after prepare. */
+	memset(substream->runtime->dma_area, 0, substream->runtime->dma_bytes);
+	priv->produced = 0;
+	priv->consumed = 0;
+	priv->read_offset = 0;
+	priv->elapsed = 0;
+	spin_lock_irqsave(&priv->write_lock, flags);
+	priv->cur_write_offset = 0;
+	spin_unlock_irqrestore(&priv->write_lock, flags);
+	return 0;
+}
