# Native Biscuit AArch64 kernel configuration.
CONFIG_LOCALVERSION="-encore-biscuit-arm64-stpfix1-lesmp1"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS_39=y
CONFIG_RANDOMIZE_BASE=n
CONFIG_COMPAT=n
CONFIG_CPU_FREQ=n
CONFIG_CPU_IDLE=n
CONFIG_COMMON_CLK_MT8163=y
CONFIG_PINCTRL_MT8163=y
CONFIG_MTK_SCPSYS_MT8163=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_WATCHDOG=y
CONFIG_MEDIATEK_WATCHDOG=y
CONFIG_TMPFS=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_RNDIS=n
CONFIG_USB_CONFIGFS_F_FS=n
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_PANIC_ON_OOPS=n
CONFIG_PANIC_TIMEOUT=0
CONFIG_CMDLINE="console=ttyAMA0,115200 console=ttyS0,921600n1 earlycon clk_ignore_unused maxcpus=1 rdinit=/init panic=0"
CONFIG_CMDLINE_FORCE=y
CONFIG_EXTRA_FIRMWARE=""
CONFIG_MTK_MT8163_CONSYS=y
CONFIG_MTK_MT8163_BLUEZ_HCI=n
CONFIG_BT=y
CONFIG_BT_HCIVHCI=y
CONFIG_CFG80211=y
CONFIG_AMZ_PRIVACY=y
CONFIG_SOUND=y
CONFIG_SND_SOC_MT8163=y
CONFIG_SND_SOC_MT8163_RADAR_PUFFIN=y
CONFIG_SND_SOC_TLV320AIC3101_AMAZON=y
CONFIG_SND_SOC_AMZN_MT8163_SPI_AUDIO=y
CONFIG_SND_SOC_8_MICS=y
CONFIG_IIO=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_IS31FL32XX=y
