#!/bin/sh
# Never commit solely because a process exists. The runtime writes ready only
# after playback and controls initialize and capture is working or safely
# disabled by privacy. Ready does not qualify the physical microphone path.
set -eu
provisioning_live() {
  [ ! -s /data/encore/wpa_supplicant.conf ] || return 1
  [ -s /run/encore/provisioning-ready ] || return 1
  read -r pid stamp extra < /run/encore/provisioning-ready 2>/dev/null || return 1
  case "$pid:$stamp:$extra" in *[!0-9:]*|:*|*::*|*:0:*) return 1;; esac
  [ -n "$stamp" ] && [ -z "$extra" ] && [ "$pid" -gt 0 ] || return 1
  now=$(date +%s)
  [ "$stamp" -le "$now" ] && [ "$((now-stamp))" -le 10 ] && kill -0 "$pid" 2>/dev/null
}
native=false
[ ! -f /run/encore/native-ab ] || native=true
i=0
while [ "$i" -lt 180 ]; do
  # A supervised candidate can wait for explicit activation indefinitely.
  # Neither a stale ready marker nor enrollment may commit a held slot.
  slot=$(cat /run/encore/slot)
  case "$slot" in a|b) ;; *) exit 1;; esac
  if ! $native && [ "$(cat /store/encore/slots/$slot.state)" = held ]; then
    sleep 1
    continue
  fi
  # First-boot Wi-Fi entry is not a failed update. No slot is committed while
  # waiting. Only a fresh heartbeat from registered, functioning Improv and
  # Action input pauses the budget, never the Bluetooth supervisor marker.
  if [ ! -f /run/encore/arm64-update-trial ] && [ ! -f /run/encore/native-watchdog-armed ] && provisioning_live; then
    sleep 1
    continue
  fi
  if [ -e /run/encore/base-ready ] && [ -s /run/encore/ready ]; then
    pid=$(cat /run/encore/ready)
    sleep 30
    if [ "$(cat /run/encore/ready 2>/dev/null)" = "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      if $native; then exec /usr/local/bin/arm64-verify native-confirm; fi
      exec /usr/local/sbin/slotctl commit
    fi
  fi
  sleep 1
  i=$((i+1))
done
# The native watchdog owns the failed-trial reset; never change the recovery
# selector or issue a second reset from the runtime health service.
if $native; then exit 1; fi
# A confirmed upgrade bought one boot attempt, spent in recovery before
# switch_root. Leave the high-water mark in place and boot the other good slot.
if [ -f /run/encore/arm64-update-trial ] && [ "$(cat /store/encore/slots/$slot.state)" = update-spent ]; then
  sync
  exec reboot
fi
# Spend the second trial attempt. The next failed trial falls back to good.
# The private starter never reboots behind the USB operator's back.
[ "${1:-}" != supervised ] || exit 1
slot=$(cat /run/encore/slot)
case "$(cat /store/encore/slots/$slot.state)" in trial*) sync; reboot -f;; esac
