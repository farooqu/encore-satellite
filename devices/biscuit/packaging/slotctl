#!/bin/sh
# Encore rootfs slots, NOT Android boot_a/boot_b. Called before switch_root.
set -eu
STORE=${STORE:-/store/encore}
BOOTED=${BOOTED:-/run/encore/slot}
put() { printf '%s\n' "$2" > "$1.new"; sync; mv -f "$1.new" "$1"; sync; }
state() { cat "$STORE/slots/$1.state" 2>/dev/null || echo absent; }
other() { if [ "$1" = a ]; then echo b; else echo a; fi; }
valid() { case "$1" in a|b) ;; *) echo 'invalid slot' >&2; exit 1;; esac; }
[ "$(cat "$STORE/format")" = encore-biscuit-v1 ]
case "${1:-}" in
next)
  slot=$(cat "$STORE/active"); valid "$slot"
  for candidate in "$slot" "$(other "$slot")"; do
    [ -x "$STORE/slots/$candidate/sbin/init" ] || continue
    case "$(state "$candidate")" in
      good) ;;
      'trial 2') put "$STORE/slots/$candidate.state" 'trial 1';;
      'trial 1') put "$STORE/slots/$candidate.state" 'trial 0';;
      *) put "$STORE/slots/$candidate.state" bad; continue;;
    esac
    put "$STORE/active" "$candidate"
    echo "$candidate"
    exit 0
  done
  exit 1
  ;;
commit)
  slot=$(cat "$BOOTED"); valid "$slot"
  [ "$(cat "$STORE/active")" = "$slot" ]
  case "$(state "$slot")" in good|'trial 0'|'trial 1') ;; *) exit 1;; esac
  put "$STORE/slots/$slot.state" good
  ;;
status)
  printf 'active=%s a=%s b=%s\n' "$(cat "$STORE/active")" "$(state a)" "$(state b)"
  ;;
*) echo 'usage: slotctl next|commit|status' >&2; exit 1;;
esac
