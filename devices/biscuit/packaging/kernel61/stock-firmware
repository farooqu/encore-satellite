#!/bin/sh
# Check both stock slots in TWRP, or load only system_a into the RAM root.
set -eu
umask 077
mode=${1:-}
case "$mode" in
  check) work=/tmp; devices=/dev/block;;
  load) work=/run/encore; devices=/dev;;
  *) exit 2;;
esac

fail() { echo "Stock radio firmware: $*" >&2; exit 1; }
scratch=$(mktemp -d "$work/stock-firmware.XXXXXX")
mounted=0
cleanup() {
  if [ "$mounted" = 1 ]; then umount "$scratch/stock" || return 1; fi
  rm -rf "$scratch"
}
trap 'result=$?; cleanup || result=1; exit "$result"' EXIT
trap 'exit 1' HUP INT TERM
mkdir "$scratch/stock"

# Complete Fire OS 6.5.7.4 radio set, independently listed by LibreEcho
# (mt8163-v181-stock-v3.tsv) and Kiosk Satellite (blobs/biscuit/radio.txt).
verify() (
  cd "$1" || exit 1
  while read -r hash size file; do
    [ -f "$file" ] && [ ! -L "$file" ] || exit 1
    [ "$(stat -c %s "$file")" = "$size" ] || exit 1
    actual=$(sha256sum < "$file") || exit 1
    [ "${actual%% *}" = "$hash" ] || exit 1
  done <<'EOF'
6642cfd4fd67accf27b0f9615e4cd0941417ddbc3b5bef1004fe1eb59235146f 128744 ROMv2_lm_patch_1_0_hdr.bin
c4aa6dfc54b82f496d97be8eb3979232730f51a3fdfad34192b91d0b87b06a56 52160 ROMv2_lm_patch_1_1_hdr.bin
9669cc9b03cfdc5e8fd4fd6e14c4c4050e8c196738ca4707eea12f14a6a8e64c 373840 WIFI_RAM_CODE_8163
302bd4462de99c028c04092e561c1500d65582ce42a93c4c72ccae6e2c99013d 119 WMT_SOC.cfg
EOF
)

inspect() {
  slot=$1
  node=mmcblk0p$2
  sys=/sys/class/block/$node
  [ -b "$devices/$node" ] && grep -qx "PARTNAME=$slot" "$sys/uevent" ||
    fail "$slot is not the expected Biscuit partition ($node)"
  devnum=$(cat "$sys/dev")
  # Don't share an existing mount (including one exposed through another alias).
  existing=$(awk -v dev="$devnum" '$3 == dev { print $5 }' /proc/self/mountinfo) ||
    fail "could not inspect mounts for $slot"
  [ -z "$existing" ] || fail "$slot is already mounted; unmount it first"
  mount -t ext4 -o ro,noload,nosuid,nodev,noexec "$devices/$node" "$scratch/stock" ||
    fail "could not mount $slot read-only without journal replay"
  mounted=1
  source=
  for layout in etc/firmware vendor/firmware system/vendor/firmware system/etc/firmware; do
    dir=$scratch/stock
    rest=$layout
    while :; do
      dir=$dir/${rest%%/*}
      [ -d "$dir" ] && [ ! -L "$dir" ] || break
      case "$rest" in
        */*) rest=${rest#*/};;
        *) if verify "$dir"; then source=$dir; fi; break;;
      esac
    done
    [ -z "$source" ] || break
  done
  [ -n "$source" ] || fail "$slot lacks the supported Fire OS 6.5.7.4 radio firmware set"
  if [ "$mode" = load ]; then
    mkdir "$scratch/payload"
    cp "$source/ROMv2_lm_patch_1_0_hdr.bin" "$source/ROMv2_lm_patch_1_1_hdr.bin" \
       "$source/WIFI_RAM_CODE_8163" "$source/WMT_SOC.cfg" "$scratch/payload/"
    chmod 600 "$scratch/payload/"*
    verify "$scratch/payload" || fail 'RAM copy failed verification'
  fi
  umount "$scratch/stock" || fail "could not unmount $slot"
  mounted=0
  echo "Stock radio firmware: $slot verified"
}

inspect system_a 13
if [ "$mode" = check ]; then
  inspect system_b 14
else
  [ ! -e "$work/firmware" ] && [ ! -L "$work/firmware" ] || fail 'RAM destination already exists'
  mv "$scratch/payload" "$work/firmware"
fi
