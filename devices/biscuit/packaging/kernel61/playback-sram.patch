+static int mt8163_pcm_fill_silence(struct snd_pcm_substream *substream,
+				 int channel, unsigned long pos,
+				 unsigned long bytes)
+{
+	struct snd_soc_component *component = snd_soc_rtdcom_lookup(
+		asoc_substream_to_rtd(substream), MT8163_AFE_COMPONENT_NAME);
+	struct mt8163_afe *afe = snd_soc_component_get_drvdata(component);
+	size_t size = substream->runtime->dma_bytes;
+	size_t first;
+
+	if (channel != 0 || pos >= size || bytes > size)
+		return -EINVAL;
+	/* All advertised formats (S16_LE/S24_LE/S32_LE) use zero silence.
+	 * pos/bytes are bytes, not frames. This can run under the stream lock;
+	 * do not allocate, sleep or acquire afe->lock here.
+	 */
+	first = min_t(size_t, bytes, size - pos);
+	memset_io(afe->sram + pos, 0, first);
+	if (first < bytes)
+		memset_io(afe->sram, 0, bytes - first);
+	return 0;
+}
+
+static int mt8163_pcm_copy_kernel(struct snd_pcm_substream *substream,
+				int channel, unsigned long pos,
+				void *buf, unsigned long bytes)
+{
+	struct snd_soc_component *component = snd_soc_rtdcom_lookup(
+		asoc_substream_to_rtd(substream), MT8163_AFE_COMPONENT_NAME);
+	struct mt8163_afe *afe = snd_soc_component_get_drvdata(component);
+	size_t size = substream->runtime->dma_bytes;
+	size_t first;
+
+	if (channel != 0 || pos >= size || bytes > size)
+		return -EINVAL;
+	first = min_t(size_t, bytes, size - pos);
+	memcpy_toio(afe->sram + pos, buf, first);
+	if (first < bytes)
+		memcpy_toio(afe->sram, buf + first, bytes - first);
+	return 0;
+}
+
+static int mt8163_pcm_construct(struct snd_soc_component *component,
+			       struct snd_soc_pcm_runtime *rtd)
+{
+	/* Linux 6.1 has no component fill_silence/copy_kernel hooks. ASoC has
+	 * already installed &rtd->ops on the PCM before pcm_construct runs.
+	 * Keep its other operations; replace only the generic SRAM accesses.
+	 */
+	rtd->ops.fill_silence = mt8163_pcm_fill_silence;
+	rtd->ops.copy_kernel = mt8163_pcm_copy_kernel;
+	return 0;
+}
