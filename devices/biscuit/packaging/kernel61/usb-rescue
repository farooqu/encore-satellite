#!/bin/sh
# Experimental initramfs/RAM-root helper. Not installed by the release packager.
# No partition writes, Android USB nodes or GPIO35 (microphone power) changes.
set -eu
BB=/bin/busybox.static
# Only the console owner holds this lock; interactive children must not keep
# it after a supervisor crash. Reuse our complete gadget on init respawn.
$BB mkdir -p /run/encore
exec 9>/run/encore/usb-rescue.lock
$BB flock -n 9 || exit 1
ready=/run/encore/usb-ready
$BB rm -f "$ready"
trap '$BB rm -f "$ready"' EXIT
config=/sys/kernel/config
$BB mkdir -p "$config"
$BB mountpoint -q "$config" || $BB mount -t configfs configfs "$config"
g=$config/usb_gadget/encore-biscuit61
i=0
while :; do
  set -- /sys/class/udc/*
  if test "$#" -eq 1 && test -d "$1"; then break; fi
  i=$((i+1)); test "$i" -le 15
  $BB sleep 1
done
udc=${1##*/}
if test -e "$g"; then
  # Never steal/recompose an unknown or partly configured gadget.
  test "$( $BB cat "$g/idVendor" )" = 0x18d1
  test "$( $BB cat "$g/idProduct" )" = 0x4ee7
  test "$( $BB cat "$g/strings/0x409/product" )" = 'Biscuit experimental rescue'
  test "$( $BB cat "$g/UDC" )" = "$udc"
  set -- "$g/functions/"*
  test "$#" -eq 1
  test "$1" = "$g/functions/acm.usb0"
  set -- "$g/configs/"*
  test "$#" -eq 1
  test "$1" = "$g/configs/c.1"
  test "$( $BB readlink -f "$g/configs/c.1/acm.usb0" )" = "$g/functions/acm.usb0"
else
  $BB mkdir "$g"
  echo 0x18d1 > "$g/idVendor"
  echo 0x4ee7 > "$g/idProduct"
  echo 0x02 > "$g/bDeviceClass"
  $BB mkdir -p "$g/strings/0x409" "$g/configs/c.1/strings/0x409"
  echo Encore > "$g/strings/0x409/manufacturer"
  echo 'Biscuit experimental rescue' > "$g/strings/0x409/product"
  echo ACM > "$g/configs/c.1/strings/0x409/configuration"
  $BB mkdir "$g/functions/acm.usb0"
  $BB ln -s "$g/functions/acm.usb0" "$g/configs/c.1/acm.usb0"
  echo "$udc" > "$g/UDC"
fi
i=0
while ! test -c /dev/ttyGS0; do
  $BB mdev -s
  i=$((i+1)); test "$i" -le 15
  $BB sleep 1
done
echo "$$" > "$ready"
while :; do
  if test -f /etc/encore/usb-ctty; then
    # Explicit script input avoids the interactive editor's cursor queries,
    # which a framed serial client is not a terminal emulator for.
    $BB setsid -c "$BB" sh /proc/self/fd/0 9>&- < /dev/ttyGS0 > /dev/ttyGS0 2>&1 || :
  else
    $BB sh 9>&- < /dev/ttyGS0 > /dev/ttyGS0 2>&1 || :
  fi
  $BB sleep 2
done
