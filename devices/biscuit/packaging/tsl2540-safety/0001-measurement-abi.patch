+/* Caller holds lock. This is a bus acquisition, not an ADC-ready indication. */
+static int tsl2540_acquire_measurement(struct tsl2540_chip *chip,
+	u64 *start_ns, u64 *end_ns)
+{
+	static const u8 config_regs[] = {
+		TSL2540_REG_ENABLE, TSL2540_REG_ATIME, TSL2540_REG_WTIME,
+		TSL2540_REG_CFG0, TSL2540_REG_CFG1, TSL2540_REG_CFG2,
+		TSL2540_REG_AZ_CONFIG,
+	};
+	u64 settle_us;
+	u8 value;
+	int rc;
+	unsigned int i;
+
+	if (!chip->measurement_initialized || chip->in_suspend ||
+		chip->unpowered || !chip->als_enabled)
+		return -EAGAIN;
+	/* Do not race an integration using the previous automatic gain. */
+	if (chip->als_gain_auto)
+		return -EBUSY;
+
+	for (i = 0; i < ARRAY_SIZE(config_regs); i++) {
+		rc = ams_i2c_read(chip->client, config_regs[i], &value);
+		if (rc != 1) {
+			chip->measurement_ready_ns = 0;
+			return rc < 0 ? rc : -EIO;
+		}
+		if (value != chip->shadow[config_regs[i]]) {
+			chip->measurement_ready_ns = 0;
+			return -EIO;
+		}
+	}
+	if ((chip->shadow[TSL2540_REG_ENABLE] & (TSL2540_PON | TSL2540_AEN))
+		!= (TSL2540_PON | TSL2540_AEN))
+		return -EAGAIN;
+	/* SAI can leave the ADC asleep with PON still reading as one. */
+	rc = ams_i2c_read(chip->client, TSL2540_REG_CFG3, &value);
+	if (rc != 1)
+		return rc < 0 ? rc : -EIO;
+	if (value & 0x10)
+		return -EOPNOTSUPP;
+
+	tsl2540_calc_cpl(chip);
+	if (!chip->als_inf.cpl)
+		return -ERANGE;
+
+	/*
+	 * Discard the first observation after any configuration write. Allow two
+	 * nominal cycles at the datasheet's maximum 2.90ms integration step.
+	 * This minimum holdoff is NOT proof of ADC progress or an autozero bound.
+	 */
+	if (!chip->measurement_ready_ns) {
+		settle_us = (chip->shadow[TSL2540_REG_ATIME] + 1) * 2900ULL;
+		if (chip->shadow[TSL2540_REG_ENABLE] & TSL2540_WEN)
+			settle_us += (chip->shadow[TSL2540_REG_WTIME] + 1) *
+				2900ULL * ((chip->shadow[TSL2540_REG_CFG0] &
+				TSL2540_MASK_WLONG) ? 12 : 1);
+		chip->measurement_ready_ns = ktime_get_ns() + settle_us * 2000;
+		return -EAGAIN;
+	}
+	if (ktime_get_ns() < chip->measurement_ready_ns)
+		return -EAGAIN;
+
+	*start_ns = ktime_get_ns();
+	rc = tsl2540_read_als(chip);
+	if (rc)
+		return rc;
+	rc = tsl2540_calculate_lux(chip);
+	if (rc)
+		return rc;
+	*end_ns = ktime_get_ns();
+	chip->measurement_sequence++;
+	return 0;
+}
